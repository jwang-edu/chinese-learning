DEEPSEEK_API_KEY=

# Natural voice / TTS
TTS_PROVIDER=minimax
TTS_API_KEY=
# Optional for organization/enterprise MiniMax accounts. Personal accounts may not have this.
TTS_GROUP_ID=
# Optional. Leave blank to use MiniMax built-in test voices.
TTS_VOICE_ID_MOMO=
TTS_VOICE_ID_YAYA=

# Optional provider overrides
TTS_MODEL=speech-02-hd
TTS_MINIMAX_ENDPOINT=https://api.minimax.chat/v1/t2a_v2
